<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================================
         父POM继承
         说明：继承 microservice-framework-parent（非 starter-parent）
         原因：security-starter 是框架内部组件，不是业务应用
         ======================================================================== -->
    <parent>
        <groupId>com.microservice.framework</groupId>
        <artifactId>microservice-framework-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../microservice-framework-parent/pom.xml</relativePath>
    </parent>

    <!-- ========================================================================
         项目基本信息
         ======================================================================== -->
    <artifactId>microservice-framework-security-starter</artifactId>
    <packaging>jar</packaging>

    <name>Microservice Framework Security Starter</name>
    <description>Security Starter - 提供 Keycloak JWT 认证、服务身份校验、接口权限控制、CORS 和路径安全规则</description>

    <!-- ========================================================================
         依赖管理
         说明：导入 BOM 以获取内部组件和第三方库的版本管理
         ======================================================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- 导入框架 BOM，获取内部组件版本 -->
            <dependency>
                <groupId>com.microservice.framework</groupId>
                <artifactId>microservice-framework-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 导入第三方依赖 BOM -->
            <dependency>
                <groupId>com.microservice.framework</groupId>
                <artifactId>microservice-framework-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ========================================================================
         依赖声明
         说明：所有依赖版本由 BOM 统一管理
         ======================================================================== -->
    <dependencies>
        <!-- ====================================================================
             Common Starter（强制依赖）
             作用：提供 FrameworkException、FrameworkErrorCode 等基础设施
             版本：由 microservice-framework-bom 管理
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-common-starter</artifactId>
        </dependency>

        <!-- ====================================================================
             JSON Starter（强制依赖）
             作用：提供 JSON 序列化能力，用于 JWT claims 解析
             版本：由 microservice-framework-bom 管理
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-json-starter</artifactId>
        </dependency>

        <!-- ====================================================================
             Spring Boot Starter Security（强制依赖）
             作用：提供 Spring Security 核心能力（SecurityFilterChain、认证/授权框架）
             版本：由 spring-boot-dependencies 管理
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ====================================================================
             Spring Boot Starter OAuth2 Resource Server（强制依赖）
             作用：提供 JWT / Opaque Token 验证能力，配合 Keycloak 使用
             原因：Security 自动配置公开签名依赖 JwtDecoder，且 Keycloak/JWT 是本 Starter 核心能力
             版本：由 spring-boot-dependencies 管理
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ====================================================================
             Spring Boot Starter Validation（强制依赖）
             作用：启用 SecurityProperties 的 Jakarta Bean Validation 配置校验
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ====================================================================
             Logging Starter（可选依赖）
             作用：提供结构化日志，记录安全事件（认证失败、权限拒绝等）
             可选：业务项目如果不需要安全事件日志，可以不引入
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-logging-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Web Starter（可选依赖）
             作用：提供 HTTP 入口和统一响应，Security Starter 在 Web 应用中默认激活
             可选：仅在 Web 应用中需要
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-web-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Spring Boot Configuration Processor
             作用：生成配置元数据，支持 IDE 自动补全
             可选：仅在开发时需要
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Test Dependencies
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
