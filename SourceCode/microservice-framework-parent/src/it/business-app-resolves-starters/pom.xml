        <groupId>com.microservice.framework</groupId>
        <artifactId>microservice-framework-starter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>business-app-resolves-starters-fixture</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <dependencies>
