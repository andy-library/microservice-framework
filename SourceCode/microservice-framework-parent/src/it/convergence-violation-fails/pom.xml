<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Contract #9: Dependency convergence violation must be caught by Enforcer.
         Strategy: Declare two dependencies that transitively bring
         different versions of the same artifact.
         Spring Boot starter brings spring-boot-autoconfigure at BOM version.
         We also explicitly declare spring-boot-autoconfigure at a different version.
         This creates a genuine DependencyConvergence conflict. -->
    <parent>
        <groupId>com.microservice.framework</groupId>
        <artifactId>microservice-framework-starter-parent</artifactId>
        <version>1.0.0-alpha.1</version>
        <relativePath/>
    </parent>

    <artifactId>convergence-violation-fails-fixture</artifactId>
    <version>1.0.0-alpha.1</version>

    <dependencies>
        <!-- spring-boot-starter transitively brings spring-boot-autoconfigure at 3.3.13 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Explicitly declare spring-boot-autoconfigure at a conflicting version -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.2.0</version>
        </dependency>
    </dependencies>
</project>
