<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================================
         父POM继承
         说明：继承 microservice-framework-parent（非 starter-parent）
         原因：database-starter 是框架内部组件，不是业务应用
         ======================================================================== -->
    <parent>
        <groupId>com.microservice.framework</groupId>
        <artifactId>microservice-framework-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../microservice-framework-parent/pom.xml</relativePath>
    </parent>

    <!-- ========================================================================
         项目基本信息
         ======================================================================== -->
    <artifactId>microservice-framework-database-starter</artifactId>
    <packaging>jar</packaging>

    <name>Microservice Framework Database Starter</name>
    <description>数据库 Starter - 提供数据源配置、读写分离、分库分表、事务管理、数据迁移、幂等与 Outbox 支持</description>

    <!-- ========================================================================
         依赖管理
         说明：导入 BOM 以获取内部组件和第三方库的版本管理
         ======================================================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- 导入框架 BOM，获取内部组件版本 -->
            <dependency>
                <groupId>com.microservice.framework</groupId>
                <artifactId>microservice-framework-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 导入第三方依赖 BOM -->
            <dependency>
                <groupId>com.microservice.framework</groupId>
                <artifactId>microservice-framework-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ========================================================================
         依赖声明
         说明：所有依赖版本由 BOM 统一管理
         ======================================================================== -->
    <dependencies>
        <!-- ====================================================================
             Common Starter（强制依赖）
             作用：提供 FrameworkException、FrameworkErrorCode 等基础设施
             原因：所有 Starter 依赖 Common 作为核心基础设施
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-common-starter</artifactId>
        </dependency>

        <!-- ====================================================================
             JSON Starter（强制依赖）
             作用：提供 JSON 序列化能力，OutboxPublisher 依赖 JSON 处理事件
             原因：Outbox 事件需要 JSON 序列化/反序列化
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-json-starter</artifactId>
        </dependency>

        <!-- ====================================================================
             Spring Boot Starter JDBC（强制依赖）
             作用：提供 DataSource、HikariCP、JdbcTemplate 等核心数据库能力
             版本：由 spring-boot-dependencies 管理
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ====================================================================
             Spring Boot Validation Starter
             作用：启用 @ConfigurationProperties 参数校验，启动期拦截非法数据库治理配置
             版本：由 spring-boot-dependencies 管理
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ====================================================================
             Logging Starter（可选依赖）
             作用：提供 SQL 日志增强和慢查询日志
             原因：并非所有场景需要增强日志，作为可选依赖便于用户按需引入
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-logging-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Observability Starter（可选依赖）
             作用：提供数据库操作的 Trace 和 Metrics 增强
             原因：并非所有场景需要 Observability，作为可选依赖便于用户按需引入
             ==================================================================== -->
        <dependency>
            <groupId>com.microservice.framework</groupId>
            <artifactId>microservice-framework-observability-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Spring Cloud Context（可选依赖）
             作用：提供 @RefreshScope 支持，配合 Nacos/Apollo 动态刷新数据源
             原因：仅在使用配置中心动态刷新数据源时需要
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             ShardingSphere-JDBC（强制依赖）
             作用：提供读写分离和分库分表能力
             原因：database-starter 默认集成 ShardingSphere-JDBC，默认不开启分库分表，
                   但提供读写分离能力；版本由 microservice-framework-dependencies 统一治理
             ==================================================================== -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
        </dependency>

        <!-- ====================================================================
             Flyway Core（可选依赖）
             作用：提供数据库迁移能力
             原因：并非所有项目使用 Flyway 迁移，作为可选依赖便于用户按需引入；
                   Flyway 依赖较小，直接作为 optional 编译依赖
             ==================================================================== -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Spring Boot Configuration Processor（可选依赖）
             作用：生成配置元数据，支持 IDE 自动补全
             原因：仅在开发时需要
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====================================================================
             Test Dependencies
             ==================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2：单元测试用内存数据库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
